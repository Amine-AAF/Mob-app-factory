{
  "id": "autocare",
  "name": "AutoCare",
  "storeName": "AutoCare - Car Maintenance",
  "slug": "autocare",
  "scheme": "autocare",
  "packageId": "com.mobileappsfactory.autocare",
  "version": "1.0.0",
  "versionCode": 1,
  "category": "auto-vehicles",
  "defaultLocale": "en",
  "locales": ["en", "fr", "es"],
  "plannedLocales": ["pt", "de", "ar"],
  "brand": { "primary": "#1E5AA8", "accent": "#F2A33A", "splashBackground": "#0B1422" },
  "monetization": {
    "model": "hybrid",
    "subscriptions": {
      "provider": "revenuecat",
      "entitlementId": "premium",
      "offeringId": "default",
      "plans": [
        { "productId": "autocare_premium_monthly", "period": "monthly", "indicativePriceUsd": 2.99 },
        { "productId": "autocare_premium_annual", "period": "annual", "indicativePriceUsd": 17.99 },
        { "productId": "autocare_premium_lifetime", "period": "lifetime", "indicativePriceUsd": 29.99 }
      ]
    },
    "ads": { "provider": "admob", "placements": ["banner"], "graceSessions": 2 }
  },
  "features": {
    "vehicles": true,
    "dashboard": true,
    "maintenance": true,
    "fuel": true,
    "expenses": true,
    "insurance": true,
    "documents": true,
    "deadlines": true,
    "tires": true,
    "comparison": true,
    "reports": true,
    "templates": true,
    "reminders": true,
    "backupRestore": true
  },
  "build": { "minSdkVersion": 24, "targetSdkVersion": 36, "easProjectIdEnv": "EAS_PROJECT_ID" },
  "releaseStatus": "development"
}
