# Copy to .env (git-ignored) for local builds. In CI these come from protected GitLab variables.
# EXPO_PUBLIC_* values are embedded in the app bundle (public keys / IDs, not secrets).

# development | preview | production  (dev & preview always use Google test ad IDs)
APP_VARIANT=development

# EAS project (from `eas init`)
EAS_PROJECT_ID=

# Production only — AdMob
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=

# RevenueCat public Android SDK key (leave empty to run without subscriptions)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Public legal pages
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
