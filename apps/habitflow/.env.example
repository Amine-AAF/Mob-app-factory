# HabitFlow — copy to .env for local production-like builds. Never commit real values.
# Development and preview builds always use Google's public AdMob test IDs.
APP_VARIANT=development
EAS_PROJECT_ID=
# RevenueCat public Android SDK key (without it the app runs free, the paywall says the store is unavailable)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# AdMob (production only — protected CI variables, environment scope production/habitflow)
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
# Public policy pages (shown in Settings when set)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
