{
  "id": "mealwise",
  "name": "MealWise",
  "storeName": "MealWise: Meal Planner & List",
  "slug": "mealwise",
  "scheme": "mealwise",
  "packageId": "com.mealwise.app",
  "version": "1.0.0",
  "versionCode": 1,
  "category": "food-drink",
  "defaultLocale": "en",
  "locales": ["en", "fr", "es"],
  "plannedLocales": ["de", "pt"],
  "brand": { "primary": "#C2410C", "accent": "#2F9E44", "splashBackground": "#1C1410" },
  "monetization": {
    "model": "hybrid",
    "subscriptions": {
      "provider": "revenuecat",
      "entitlementId": "premium",
      "offeringId": "default",
      "plans": [
        { "productId": "mealwise_premium_monthly", "period": "monthly", "indicativePriceUsd": 2.99 },
        { "productId": "mealwise_premium_annual", "period": "annual", "indicativePriceUsd": 17.99 },
        { "productId": "mealwise_premium_lifetime", "period": "lifetime", "indicativePriceUsd": 29.99 }
      ]
    },
    "ads": { "provider": "admob", "placements": ["banner"], "graceSessions": 2 }
  },
  "features": {
    "dashboard": true,
    "mealPlanner": true,
    "recipeBook": true,
    "cookingMode": true,
    "groceryList": true,
    "pantry": true,
    "nutritionInsights": true,
    "mealTemplates": true,
    "budget": true,
    "notifications": true,
    "backupRestore": true
  },
  "build": { "minSdkVersion": 24, "targetSdkVersion": 36, "easProjectIdEnv": "EAS_PROJECT_ID" },
  "releaseStatus": "development"
}
