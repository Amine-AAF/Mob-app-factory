{
  "id": "interviewready",
  "name": "InterviewReady",
  "storeName": "InterviewReady: Job Interview",
  "slug": "interviewready",
  "scheme": "interviewready",
  "packageId": "com.mobileappsfactory.interviewready",
  "version": "1.0.0",
  "versionCode": 1,
  "category": "education",
  "defaultLocale": "en",
  "locales": ["en", "fr", "es"],
  "plannedLocales": ["de", "pt", "ar"],
  "brand": { "primary": "#2F5BD3", "accent": "#0FA3A3", "splashBackground": "#0B1426" },
  "monetization": {
    "model": "hybrid",
    "subscriptions": {
      "provider": "revenuecat",
      "entitlementId": "premium",
      "offeringId": "default",
      "plans": [
        { "productId": "interviewready_premium_monthly", "period": "monthly", "indicativePriceUsd": 3.99 },
        { "productId": "interviewready_premium_annual", "period": "annual", "indicativePriceUsd": 19.99 },
        { "productId": "interviewready_premium_lifetime", "period": "lifetime", "indicativePriceUsd": 29.99 }
      ]
    },
    "ads": { "provider": "admob", "placements": ["banner", "rewarded", "interstitial"], "graceSessions": 2 }
  },
  "features": {
    "questionLibrary": true,
    "questionOfTheDay": true,
    "mockInterview": true,
    "answerBuilder": true,
    "flashcards": true,
    "quizzes": true,
    "learningPaths": true,
    "favoritesNotes": true,
    "backupRestore": true,
    "aiReview": false
  },
  "build": { "minSdkVersion": 24, "targetSdkVersion": 36, "easProjectIdEnv": "EAS_PROJECT_ID" },
  "releaseStatus": "development"
}
