{
  "id": "travelwise",
  "name": "TravelWise",
  "storeName": "TravelWise: Trip Planner",
  "slug": "travelwise",
  "scheme": "travelwise",
  "packageId": "com.mobileappsfactory.travelwise",
  "version": "0.1.0",
  "versionCode": 1,
  "category": "travel-local",
  "defaultLocale": "en",
  "locales": ["en", "fr", "es"],
  "plannedLocales": [],
  "brand": { "primary": "#0F766E", "accent": "#F97316", "splashBackground": "#062A28" },
  "monetization": {
    "model": "hybrid",
    "subscriptions": {
      "provider": "revenuecat",
      "entitlementId": "premium",
      "offeringId": "default",
      "plans": [
        { "productId": "travelwise_premium_monthly", "period": "monthly", "indicativePriceUsd": 2.99 },
        { "productId": "travelwise_premium_annual", "period": "annual", "indicativePriceUsd": 17.99 },
        { "productId": "travelwise_premium_lifetime", "period": "lifetime", "indicativePriceUsd": 29.99 }
      ]
    },
    "ads": { "provider": "admob", "placements": ["banner", "interstitial", "rewarded"], "graceSessions": 2 }
  },
  "features": {
    "trips": true,
    "itinerary": true,
    "bookings": true,
    "budget": true,
    "sharedExpenses": true,
    "currencyConverter": true,
    "packing": true,
    "checklists": true,
    "documents": true,
    "places": true,
    "journal": true,
    "weatherNotes": true,
    "notifications": false,
    "backupRestore": false
  },
  "build": { "minSdkVersion": 24, "targetSdkVersion": 36, "easProjectIdEnv": "EAS_PROJECT_ID" },
  "releaseStatus": "development"
}
