# Copy to .env (git-ignored) for local builds. In CI these come from protected GitLab / EAS variables.
# EXPO_PUBLIC_* values are embedded in the app bundle: public identifiers only, never secrets.

# development | preview | production
APP_VARIANT=development

# EAS project (from `eas init`)
EAS_PROJECT_ID=

# RevenueCat public Android SDK key (Google Play Billing). Leave empty to run without purchases:
# the app then stays on the free plan and never fakes a purchase.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Public legal pages (shown in Settings > About)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
