# Copy to .env (never commit it). All values are optional in development:
# without them ImageCraft runs as a free app with Google's TEST ad units.
APP_VARIANT=development
EAS_PROJECT_ID=
# RevenueCat public Android SDK key (Premium). Empty = store unavailable, no simulated purchase.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# AdMob (production builds only; development/preview always use Google test IDs)
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
